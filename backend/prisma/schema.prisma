// Prisma schema file for Pyramid Task Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  name            String
  isGuest         Boolean   @default(true)
  themePreference String    @default("system")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tasks           Task[]
  projects        Project[]
}

model Project {
  id        String   @id @default(uuid())
  name      String
  priority  String   @default("Medium")
  lead      String   @default("Admin")
  dueDate   String   @default("")
  status    String   @default("To Do")
  team      String   @default("")
  labels    String   @default("")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id           String   @id @default(uuid())
  title        String
  description  String?
  status       String   @default("To Do") // "To Do", "Doing", "Completed", "On Hold"
  priority     String   @default("MEDIUM")
  category     String   @default("Deployment")
  assigneeName String   @default("Admin")
  tags         String   @default("Deployment,Deployment")
  dueDate      String   @default("29 Jul")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
