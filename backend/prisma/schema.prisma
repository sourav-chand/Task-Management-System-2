// Prisma schema file for Pyramid Task Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String   @id @default(uuid())
  email           String?  @unique
  name            String
  isGuest         Boolean  @default(true)
  themePreference String   @default("system")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tasks           Task[]
}

model Task {
  id           String   @id @default(uuid())
  title        String
  description  String?
  status       String   @default("To Do") // "To Do", "Doing", "Completed", "On Hold"
  priority     String   @default("MEDIUM")
  category     String   @default("Deployment")
  assigneeName String   @default("Admin")
  tags         String   @default("Deployment,Deployment")
  dueDate      String   @default("29 Jul")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
